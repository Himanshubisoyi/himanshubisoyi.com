# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# CSS and JS are always linked with a ?v= version number, so they can be cached for a year.
# Remember to bump the version in every page whenever styles.css or custom.js changes.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=2592000

# Keep the Cloudflare preview addresses out of Google; the real site is himanshubisoyi.com
https://himanshubisoyi.pages.dev/*
  X-Robots-Tag: noindex

https://:version.himanshubisoyi.pages.dev/*
  X-Robots-Tag: noindex

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
